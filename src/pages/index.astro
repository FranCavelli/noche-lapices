---
import "../styles/global.css";

const ruta = (p) => import.meta.env.BASE_URL.replace(/\/$/, "") + p;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>La Noche de los Lápices — Expediente</title>
    <link rel="icon" href={ruta("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Caveat:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <section id="portada" class="pantalla activa">
      <img class="fondo-full" src={ruta("/expediente/frame-01.jpg")} alt="" />
      <div class="vineta"></div>

      <header class="portada-titulo">
        <p class="eyebrow">República Argentina · La Plata · 16.09.1976</p>
        <h1>La Noche<br />de los Lápices</h1>
        <p class="portada-sub">Restaurá lo que quisieron borrar</p>
      </header>

      <form id="ficha-ingreso" class="tarjeta-ingreso" autocomplete="off">
        <p class="tarjeta-label">Registro de visita N.º <span id="nro-visita">—</span></p>
        <label for="nombre">Nombre del visitante:</label>
        <input id="nombre" name="nombre" type="text" maxlength="24" required placeholder="escribí tu nombre" />
        <label for="telefono">Teléfono de contacto:</label>
        <input
          id="telefono"
          name="telefono"
          type="tel"
          inputmode="tel"
          minlength="6"
          maxlength="20"
          required
          placeholder="escribí tu teléfono"
        />
        <label for="email">Mail <span class="opcional">(opcional, para mandarte tu foto)</span></label>
        <input id="email" name="email" type="email" maxlength="60" placeholder="escribí tu mail" />
        <button type="submit" class="boton-sello">Abrir expediente</button>
        <p class="tarjeta-pie">7 misiones al azar · cada expediente es distinto · tu puntaje queda en el registro</p>
        <p class="tarjeta-anios">1976 — 2026 · a cincuenta años</p>
      </form>

      <aside id="podio" class="podio oculta">
        <p class="podio-titulo">Mejores puntajes</p>
        <ol id="podio-lista" class="podio-lista"></ol>
        <button id="btn-exportar-portada" class="boton-fantasma fantasma-clara" type="button">exportar registros</button>
      </aside>
    </section>

    <section id="apertura" class="pantalla">
      <img id="apertura-img" class="fondo-full" src={ruta("/expediente/frame-01.jpg")} alt="Una mano abre el expediente" />
    </section>

    <section id="juego" class="pantalla">
      <img class="fondo-full fondo-abierta" src={ruta("/expediente/frame-08.jpg")} alt="" />
      <div class="vineta"></div>

      <header class="barra-juego">
        <span class="barra-exp">EXPEDIENTE 16.09.1976</span>
        <span class="barra-jugador"><span id="hud-nombre"></span> · <b id="hud-puntos" class="lapiz">0 pts</b></span>
      </header>

      <div class="hoja-wrap">
        <article id="hoja" class="hoja">
          <div class="hoja-clip"></div>

          <div id="vista-mision" class="vista">
            <p class="ficha-num">Misión <span id="mis-num">1</span> de <span id="mis-total">7</span> — <span id="mis-titulo"></span></p>
            <p id="mis-consigna" class="consigna"></p>
            <div id="mis-cuerpo"></div>
            <div class="timer"><div id="timer-barra" class="timer-barra"></div></div>
            <div id="sello-feedback" class="sello-feedback" aria-live="polite"></div>
            <p id="mis-dato" class="mision-dato" aria-live="polite"></p>
            <p id="anota-puntos" class="anota-puntos lapiz"></p>
            <button id="btn-saltear" class="btn-saltear oculta" type="button">saltear ▸</button>
          </div>
        </article>

        <div id="galeria" class="galeria-fotos" aria-hidden="true"></div>
      </div>
    </section>

    <section id="final" class="pantalla">
      <img class="fondo-full fondo-abierta" src={ruta("/expediente/frame-08.jpg")} alt="" />
      <div class="vineta"></div>

      <div class="hoja-wrap">
        <article class="hoja hoja-final">
          <div class="hoja-clip"></div>
          <p class="ficha-num">Informe final — a 50 años · 1976-2026</p>
          <div id="final-caras" class="final-caras"></div>
          <p id="final-frase" class="final-frase">
            Claudia Falcone · María Clara Ciocchini · Horacio Ungaro ·
            Daniel Racero · Francisco López Muntaner · Claudio de Acha
          </p>
          <p class="final-desaparecidos">Siguen desaparecidos.</p>
          <p class="final-leyenda">A cincuenta años, los lápices siguen escribiendo.</p>

          <p class="final-puntaje lapiz"><span id="final-nombre"></span>: <b id="final-puntos"></b></p>
          <p id="final-detalle" class="final-detalle"></p>

          <h3 class="ranking-titulo">Registro de visitantes</h3>
          <ol id="ranking" class="ranking"></ol>

          <button id="btn-reiniciar" class="boton-sello">Cerrar expediente</button>
          <button id="btn-exportar" class="boton-fantasma" type="button">exportar registros</button>
        </article>
      </div>
    </section>

    <section id="recuerdo" class="pantalla">
      <img class="fondo-full fondo-abierta" src={ruta("/expediente/frame-08.jpg")} alt="" />
      <div class="vineta"></div>

      <div id="recuerdo-flash" class="recuerdo-flash"></div>
      <div class="recuerdo-wrap">
        <header class="recuerdo-cabecera">
          <p class="eyebrow">Antes de cerrar el expediente</p>
          <h2 class="recuerdo-titulo">Gracias por ayudar a reconstruir la historia</h2>
          <p class="recuerdo-sub">
            <span id="recuerdo-nombre"></span>, tu foto queda en el archivo junto a las de los demás visitantes.
          </p>
        </header>

        <div class="recuerdo-escena">
          <div id="recuerdo-camara" class="recuerdo-camara">
            <video id="recuerdo-video" playsinline muted></video>
            <div id="recuerdo-cuenta" class="recuerdo-cuenta"></div>
            <p class="recuerdo-sin-camara">No hay cámara disponible</p>
          </div>
          <div id="recuerdo-tira" class="recuerdo-tira"></div>
        </div>

        <p id="recuerdo-aviso" class="recuerdo-aviso"></p>

        <div class="recuerdo-acciones">
          <button id="btn-disparar" class="boton-sello" type="button">Sacar las fotos</button>
          <button id="btn-repetir" class="boton-fantasma fantasma-clara oculta" type="button">repetir</button>
          <button id="btn-mail" class="boton-fantasma fantasma-clara oculta" type="button">enviarme por mail</button>
          <button id="btn-descargar" class="boton-fantasma fantasma-clara oculta" type="button">descargar</button>
          <button id="btn-imprimir" class="boton-fantasma fantasma-clara oculta" type="button">imprimir</button>
          <button id="btn-terminar" class="boton-fantasma fantasma-clara" type="button">cerrar expediente</button>
        </div>

        <p class="recuerdo-legal">
          Las fotos quedan guardadas solo en esta computadora, para el archivo de la muestra.
          Podés cerrar el expediente sin sacarte ninguna.
        </p>
      </div>
    </section>

    <div id="archivo" class="archivo oculta">
      <div class="archivo-caja">
        <header class="archivo-barra">
          <h2>Archivo de visitas <span id="panel-total" class="archivo-total"></span></h2>
          <div class="archivo-botones">
            <button id="panel-orden" class="boton-fantasma fantasma-clara" type="button">ordenar por fecha</button>
            <button id="panel-exportar" class="boton-fantasma fantasma-clara" type="button">descargar todo (zip)</button>
            <button id="panel-vaciar" class="boton-fantasma fantasma-clara" type="button">vaciar archivo</button>
            <button id="panel-cerrar" class="boton-fantasma fantasma-clara" type="button">cerrar</button>
          </div>
        </header>
        <p id="panel-aviso" class="archivo-aviso"></p>
        <div id="panel-lista" class="archivo-lista"></div>
        <footer class="archivo-pie">
          <button id="panel-antes" class="boton-fantasma fantasma-clara oculta" type="button">‹ anteriores</button>
          <span id="panel-paginas" class="archivo-paginas"></span>
          <button id="panel-despues" class="boton-fantasma fantasma-clara oculta" type="button">siguientes ›</button>
        </footer>
      </div>
    </div>

    <div id="recuerdo-impresion" class="recuerdo-impresion"></div>

    <script>
      import "../scripts/game.js";
      import "../scripts/panel.js";
    </script>
  </body>
</html>
